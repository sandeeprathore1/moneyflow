# Supabase production database (Settings → Database → Connection string → URI)
# Use the DIRECT connection (port 5432) for migrations and the API.
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-database-password

DATABASE_URL=postgresql://postgres:your-database-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
DATABASE_SSL=true

REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-random-32-plus-character-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DEBUG=false
CORS_ORIGINS=*

OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Public API URL (set after deploying the FastAPI service)
EXPO_PUBLIC_API_URL=https://your-api-host.example.com
